# NovelForgeX 环境变量配置

# 数据库 (默认 SQLite)
# DATABASE_URL=sqlite:///./data/novelforge.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/novelforge

# 数据目录
# NOVELFORGE_DATA_DIR=./data

# LLM API Keys (也可在设置页面配置)
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# GEMINI_API_KEY=AIza-xxx

# GPT-5.5 启动自动注入 (留空则跳过)
# GPT55_BASE_URL=http://your-server:8317/v1
# GPT55_API_KEY=sk-xxx
# GPT55_MODEL=gpt-5.5

# Tomato Downloader (热门采集)
# TOMATO_DL_BASE=http://your-server:18424
# TOMATO_DL_PASSWORD=your-password
# TOMATO_DATA_BASE=http://your-server:18425

# 代理
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
